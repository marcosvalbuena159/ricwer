{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/inicio",        "destination": "public/index.html"   },
    { "source": "/cliente",       "destination": "public/cliente.html" },
    { "source": "/administrador", "destination": "public/admin.html"   }
  ],
  "redirects": [
    { "source": "/admin",         "destination": "public/admin.html", "permanent": true },
    { "source": "/admin.html",    "destination": "public/admin.html", "permanent": true },
    { "source": "/cliente.html",  "destination": "public/cliente.html", "permanent": true },
    { "source": "/index.html",    "destination": "public/index.html", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options",        "value": "DENY"    },
        { "key": "Referrer-Policy",        "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}